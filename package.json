{
  "name": "squad-surge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Squad Surge — a premium instantly-playable 3D arcade lane shooter for the browser.",
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.182.0",
    "eslint": "^9.39.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:portable": "vite build --mode portable --outDir dist-portable",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "npm run test:unit",
    "test:bdd": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit"
  }
}
